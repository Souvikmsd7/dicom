# =============================================================================
# DocMed EHR DICOM Integration POC — Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to source control.
# =============================================================================

# --- Orthanc DICOM Server ---------------------------------------------------
ORTHANC_HOST=127.0.0.1
ORTHANC_HTTP_PORT=8042
ORTHANC_DICOM_PORT=4242
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=CHANGE_ME_IN_DOT_ENV

# --- OHIF Viewer -------------------------------------------------------------
OHIF_PORT=3001

# --- Backend -----------------------------------------------------------------
BACKEND_PORT=3000
BACKEND_CORS_ORIGIN=http://localhost:5173

# --- Frontend ----------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:3000
VITE_OHIF_URL=http://localhost:3001
